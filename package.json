{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "start": "backstage-cli repo start",
    "start:catalog": "yarn workspace backend-catalog start --config ../../app-config.yaml --config ../../app-config.catalog.yaml",
    "start:search": "yarn workspace backend-search start --config ../../app-config.yaml --config ../../app-config.search.yaml",
    "start:scaffolder": "yarn workspace backend-scaffolder start --config ../../app-config.yaml --config ../../app-config.scaffolder.yaml",
    "start:techdocs": "yarn workspace backend-techdocs start --config ../../app-config.yaml --config ../../app-config.techdocs.yaml",
    "start:kubernetes": "yarn workspace backend-kubernetes start --config ../../app-config.yaml --config ../../app-config.kubernetes.yaml",
    "start:notifications": "yarn workspace backend-notifications start --config ../../app-config.yaml --config ../../app-config.notifications.yaml",
    "build:backend": "yarn workspace backend build",
    "build:backend-catalog": "yarn workspace backend-catalog build",
    "build:backend-search": "yarn workspace backend-search build",
    "build:backend-scaffolder": "yarn workspace backend-scaffolder build",
    "build:backend-techdocs": "yarn workspace backend-techdocs build",
    "build:backend-kubernetes": "yarn workspace backend-kubernetes build",
    "build:backend-notifications": "yarn workspace backend-notifications build",
    "build:backends": "yarn workspaces foreach --include backend --include backend-catalog --include backend-search --include backend-scaffolder --include backend-techdocs --include backend-kubernetes --include backend-notifications run build",
    "build:all": "backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "build-image:catalog": "yarn workspace backend-catalog build-image",
    "build-image:search": "yarn workspace backend-search build-image",
    "build-image:scaffolder": "yarn workspace backend-scaffolder build-image",
    "build-image:techdocs": "yarn workspace backend-techdocs build-image",
    "build-image:kubernetes": "yarn workspace backend-kubernetes build-image",
    "build-image:notifications": "yarn workspace backend-notifications build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/master",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new"
  },
  "backstage": {
    "cli": {
      "new": {
        "globals": {
          "license": "UNLICENSED"
        }
      }
    }
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "devDependencies": {
    "@backstage/cli": "^0.36.1",
    "@backstage/cli-defaults": "^0.1.1",
    "@backstage/e2e-test-utils": "^0.1.2",
    "@jest/environment-jsdom-abstract": "^30.0.0",
    "@playwright/test": "^1.32.3",
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "jsdom": "^27.1.0",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "typescript": "~5.8.0"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.4.1"
}
