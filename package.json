{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "start": "backstage-cli repo start",
    "start:all": "concurrently --kill-others-on-fail --prefix-colors \"bgBlue,bgGreen,bgYellow,bgMagenta,bgCyan,bgRed\" -n \"auth,core,content,aux,proxy,frontend\" \"yarn start:auth\" \"wait-on tcp:7008 && yarn start:core\" \"wait-on tcp:7008 tcp:7009 && yarn start:content\" \"wait-on tcp:7008 tcp:7009 && yarn start:aux\" \"wait-on tcp:7008 tcp:7009 tcp:7010 tcp:7011 && yarn start:proxy\" \"wait-on tcp:7008 tcp:7009 tcp:7010 tcp:7011 && yarn start:app\"",
    "start:proxy": "yarn workspace backend start",
    "start:app": "yarn workspace app start",
    "start:auth": "yarn workspace backend-auth start",
    "start:core": "yarn workspace backend-core start",
    "start:content": "yarn workspace backend-content start",
    "start:aux": "yarn workspace backend-aux start",
    "build:backend": "yarn workspace backend build",
    "build:backend-auth": "yarn workspace backend-auth build",
    "build:backend-core": "yarn workspace backend-core build",
    "build:backend-content": "yarn workspace backend-content build",
    "build:backend-aux": "yarn workspace backend-aux build",
    "build:backends": "yarn workspaces foreach --all --topological --include backend-common --include backend --include backend-auth --include backend-core --include backend-content --include backend-aux run build",
    "build:all": "yarn tsc && backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "build-image:auth": "yarn workspace backend-auth build-image",
    "build-image:core": "yarn workspace backend-core build-image",
    "build-image:content": "yarn workspace backend-content build-image",
    "build-image:aux": "yarn workspace backend-aux build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/master",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new"
  },
  "backstage": {
    "cli": {
      "new": {
        "globals": {
          "license": "UNLICENSED"
        }
      }
    }
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "devDependencies": {
    "@backstage/cli": "^0.36.1",
    "@backstage/cli-defaults": "^0.1.1",
    "@backstage/e2e-test-utils": "^0.1.2",
    "@jest/environment-jsdom-abstract": "^30.0.0",
    "@playwright/test": "^1.32.3",
    "@types/jest": "^30.0.0",
    "concurrently": "^9.0.0",
    "jest": "^30.2.0",
    "jsdom": "^27.1.0",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "typescript": "~5.8.0",
    "wait-on": "^8.0.0"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@backstage/frontend-plugin-api": "^0.16.0"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.4.1"
}
