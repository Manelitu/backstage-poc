# Copie este arquivo para .env e ajuste os valores
# O .env é lido automaticamente pelo docker compose

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=backstage
POSTGRES_PASSWORD=backstage

# ── Build ─────────────────────────────────────────────────────────────────────
# Defina como "false" em redes corporativas com certificado auto-assinado
YARN_ENABLE_STRICT_SSL=true

# ── GitHub OAuth App ──────────────────────────────────────────────────────────
# Crie em: https://github.com/settings/developers → "New OAuth App"
#   Homepage URL:              http://localhost:7007
#   Authorization callback URL: http://localhost:7007/api/auth/github/handler/frame
AUTH_GITHUB_CLIENT_ID=your_client_id_here
AUTH_GITHUB_CLIENT_SECRET=your_client_secret_here
